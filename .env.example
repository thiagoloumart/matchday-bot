# Easiest: run `npm run setup` and it writes this file for you.
# Values with # or spaces must be in quotes (e.g. TEAM_HASHTAG="#COYG").

# --- language: pt | en ---
BOT_LANGUAGE=pt
TIMEZONE=America/Sao_Paulo

# --- the team (ESPN id: the setup finds it by name) ---
TEAM_ESPN_ID=6272
TEAM_NAME=Fortaleza
TEAM_NICK=Leão
TEAM_FANS=Tricolor
TEAM_EMOJI=🦁
TEAM_COLORS=🔴🔵⚪
TEAM_HASHTAG="#BoraLeão"
GROUP_NAME="Notícias do Leão"
LEAGUES=bra.2,bra.copa_do_brazil
TABLE_LEAGUE=bra.2
NEWS_QUERY='"Fortaleza EC" OR "Fortaleza Esporte Clube"'

# --- WhatsApp via Evolution API ---
EVOLUTION_BASE_URL=https://evolution.example.com
EVOLUTION_INSTANCE=my-bot
EVOLUTION_APIKEY=
WHATSAPP_GROUP_JID=120363000000000000@g.us
WHATSAPP_TEST_NUMBER=5511999999999
BOT_NUMBER=5511888888888
INVITE_URL=https://chat.whatsapp.com/your-invite
GROUP_INVITE_URL=https://chat.whatsapp.com/your-invite

# --- optional news page ---
PAGE_ENABLED=false
PAGE_URL=https://myteam.example.com
PAGE_OUTPUT=./site/index.html
PAGE_COLOR_1="#e1261c"
PAGE_COLOR_2="#1f5cff"
EDITORIAL_ENABLED=false

# true = only logs, sends nothing
DRY_RUN=true
